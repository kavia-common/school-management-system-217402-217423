# Database (provided by platform for the PostgreSQL container)
POSTGRES_URL=postgresql://host:5432/dbname
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme

# API config
APP_NAME=School Management System API
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Security
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_MINUTES=43200

# CORS
CORS_ALLOW_ORIGINS=*
